{
  "name": "dsh-makeworld",
  "version": "0.2.1",
  "description": "dsh-makeworld：DeepSeek Harness 的任务账本插件。use the less, make more —— 记录信念、实验与证据，而不是待办清单。",
  "author": "guaidao2",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./ledger": "./src/ledger.js",
    "./tools-row": "./src/tools-row.js",
    "./store": "./src/store.js",
    "./environment": "./src/environment.js",
    "./gitbash": "./src/gitbash.js",
    "./acl-patch": "./src/acl-patch.js",
    "./mcp": "./src/mcp.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./ledger-panel": "./src/ledger-panel.js"
  },
  "files": [
    "src/**/*.js",
    "vendor/acl-sandbox-patch/preload.cjs",
    "vendor/acl-sandbox-patch/LICENSE",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-storage-domain": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-mcp-client": "^0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  }
}
